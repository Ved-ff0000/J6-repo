# Vite proxy override: export in your shell before running npm run dev.
API_PROXY_TARGET=http://127.0.0.1:8000
# Copy backend settings below to backend/.env for local runs from backend/.
LEASEGUARD_ENVIRONMENT=development
LEASEGUARD_LOG_LEVEL=INFO
LEASEGUARD_DATABASE_URL=postgresql+asyncpg://leaseguard:leaseguard@localhost:5432/leaseguard
LEASEGUARD_REDIS_URL=redis://localhost:6379/0
LEASEGUARD_DATABASE_POOL_SIZE=5
LEASEGUARD_DATABASE_MAX_OVERFLOW=5
LEASEGUARD_DEPENDENCY_TIMEOUT_SECONDS=2
# Compose uses this for local PostgreSQL. Development default only.
POSTGRES_PASSWORD=leaseguard

# Auth (generate a real random local signing key with scripts/init_dev_env.py).
# Without an explicit key, development uses an ephemeral key invalidated on restart.
# Production refuses startup unless a key of at least 32 bytes is configured.
# LEASEGUARD_JWT_SECRET=
LEASEGUARD_JWT_ISSUER=leaseguard-api
LEASEGUARD_JWT_AUDIENCE=leaseguard-web
LEASEGUARD_ACCESS_TOKEN_SECONDS=900
LEASEGUARD_REFRESH_TOKEN_SECONDS=604800
LEASEGUARD_REGISTRATION_ENABLED=true
LEASEGUARD_AUTH_RATE_LIMIT=30
LEASEGUARD_AUTH_RATE_WINDOW_SECONDS=60

# Private S3/MinIO originals. Development defaults only; never use these in production.
LEASEGUARD_STORAGE_BACKEND=s3
LEASEGUARD_S3_ENDPOINT=http://localhost:9000
LEASEGUARD_S3_BUCKET=leaseguard-documents
LEASEGUARD_S3_REGION=us-east-1
LEASEGUARD_S3_ACCESS_KEY=leaseguard-dev
LEASEGUARD_S3_SECRET_KEY=leaseguard-local-storage-only
LEASEGUARD_MAX_UPLOAD_BYTES=20971520
# Explicit development/test alternative: STORAGE_BACKEND=local (prefixed LEASEGUARD_).
LEASEGUARD_LOCAL_STORAGE_PATH=.data/objects
MINIO_ROOT_USER=leaseguard-dev
MINIO_ROOT_PASSWORD=leaseguard-local-storage-only

# Phase 5 is opt-in and only for synthetic data until malware scanning is implemented.
LEASEGUARD_PROCESSING_ENABLED=true
LEASEGUARD_ALLOW_UNSCANNED_PROCESSING=true
LEASEGUARD_PARSER_MAX_PAGES=500
LEASEGUARD_PARSER_MAX_CHARACTERS=2000000
LEASEGUARD_PARSER_MAX_CHUNKS=3000
LEASEGUARD_CHUNK_SIZE=2000
LEASEGUARD_CHUNK_OVERLAP=200
LEASEGUARD_PARSER_TIMEOUT_SECONDS=45
LEASEGUARD_PROCESSING_LEASE_SECONDS=120
LEASEGUARD_PROCESSING_MAX_ATTEMPTS=3
LEASEGUARD_PROCESSING_POLL_SECONDS=2

# Phase 6: explicit synthetic-development retrieval. Existing .env files are unchanged.
LEASEGUARD_RETRIEVAL_ENABLED=true
LEASEGUARD_QDRANT_URL=http://localhost:6333
# LEASEGUARD_QDRANT_API_KEY=
# Real offline lexical vectors, NOT neural semantic embeddings. No downloads or key needed.
LEASEGUARD_EMBEDDING_PROVIDER=hashing
LEASEGUARD_EMBEDDING_DIMENSIONS=512
# Optional real semantic embeddings: select openai and configure your trusted service/key.
# Chunk text and queries leave the backend ONLY when this provider is explicitly selected.
# LEASEGUARD_EMBEDDING_PROVIDER=openai
# LEASEGUARD_EMBEDDING_URL=https://api.openai.com/v1
# LEASEGUARD_EMBEDDING_MODEL=text-embedding-3-small
# LEASEGUARD_EMBEDDING_API_KEY=
LEASEGUARD_INDEX_TIMEOUT_SECONDS=120
LEASEGUARD_INDEX_LEASE_SECONDS=180
LEASEGUARD_INDEX_MAX_ATTEMPTS=3

# Phase 7: manual UNVERIFIED source-backed graph proposals; no automatic extraction.
LEASEGUARD_GRAPH_ENABLED=true
LEASEGUARD_NEO4J_URI=bolt://localhost:7687
LEASEGUARD_NEO4J_USERNAME=neo4j
LEASEGUARD_NEO4J_DATABASE=neo4j
# Matching synthetic-development credentials; init_dev_env.py replaces both randomly.
NEO4J_PASSWORD=leaseguard-local-graph-only
LEASEGUARD_NEO4J_PASSWORD=leaseguard-local-graph-only
LEASEGUARD_GRAPH_TIMEOUT_SECONDS=60
LEASEGUARD_GRAPH_LEASE_SECONDS=120
LEASEGUARD_GRAPH_MAX_ATTEMPTS=3

# Phase 8: real OpenAI-compatible generation adapter. OFF by default, including development.
# No key, paid request or model download is generated by init_dev_env.py.
LEASEGUARD_LLM_ENABLED=false
LEASEGUARD_LLM_PROVIDER=openai
LEASEGUARD_LLM_URL=https://api.openai.com/v1
LEASEGUARD_LLM_MODEL=gpt-4.1-mini
# Configure privately in the server environment; never commit or paste a real key.
# LEASEGUARD_LLM_API_KEY=
LEASEGUARD_LLM_TIMEOUT_SECONDS=30
LEASEGUARD_LLM_MAX_OUTPUT_TOKENS=512
LEASEGUARD_LLM_PROBE_LIMIT=3
LEASEGUARD_LLM_PROBE_WINDOW_SECONDS=600

# Phase 9: bounded document-text LangGraph workflow. OFF by default.
# Requires enabled LLM + retrieval, ready source index, explicit per-request consent.
LEASEGUARD_WORKFLOW_ENABLED=false
LEASEGUARD_WORKFLOW_TIMEOUT_SECONDS=150

# Phase 10: twelve-group source-backed lease proposals. OFF independently of candidate workflows.
# Requires enabled workflows and LLM_MAX_OUTPUT_TOKENS >= 1024 (2048 recommended for broader output).
LEASEGUARD_LEASE_EXTRACTION_ENABLED=false

# Phase 11: versioned deterministic checks, OFF by default. No model calls.
# Also annotate new LEASE_FIELDS runs when that workflow mode is enabled.
LEASEGUARD_RULES_ENABLED=false
# JSON array of known rule IDs only; empty enables every built-in rule when rules are on.
LEASEGUARD_RULES_DISABLED=[]

# Phase 12: explicit SQL-only comparison of stored source-backed lease proposals. OFF by default.
LEASEGUARD_CONFLICTS_ENABLED=false

# Phases 13–24: governed operations. Automatic review queue adds no model calls.
LEASEGUARD_REVIEW_AUTO_ENQUEUE=true
LEASEGUARD_LIVE_ENABLED=false
LEASEGUARD_EMAIL_ENABLED=false
LEASEGUARD_SMTP_HOST=localhost
LEASEGUARD_SMTP_PORT=587
LEASEGUARD_SMTP_SENDER=leaseguard@example.invalid
# LEASEGUARD_SMTP_USERNAME=
# LEASEGUARD_SMTP_PASSWORD=
LEASEGUARD_WEBHOOK_ENABLED=false
# Operator-controlled public HTTPS URL, never a client-submitted URL. No redirects.
# LEASEGUARD_WEBHOOK_URL=
# LEASEGUARD_WEBHOOK_SIGNING_KEY=
# Platform operator metrics; tenant admins cannot scrape aggregate platform traffic.
LEASEGUARD_METRICS_ENABLED=false
LEASEGUARD_OTEL_ENABLED=false
LEASEGUARD_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
